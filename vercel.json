{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/admin.html"
    },
    {
      "source": "/dev/admin",
      "destination": "/dev/admin/admin.html"
    },
    {
      "source": "/dono",
      "destination": "/dono/index.html"
    },
    {
      "source": "/plataforma",
      "destination": "/plataforma/index.html"
    },
    {
      "source": "/loja",
      "destination": "/loja/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dev",
      "destination": "/dev/",
      "permanent": true
    },
    {
      "source": "/dono",
      "destination": "/dono/",
      "permanent": true
    },
    {
      "source": "/plataforma",
      "destination": "/plataforma/",
      "permanent": true
    },
    {
      "source": "/loja",
      "destination": "/loja/",
      "permanent": true
    }
  ]
}
